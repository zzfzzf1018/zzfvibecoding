{
  "Storage": {
    "//": "数据库文件路径。相对路径基于程序所在目录；留空则使用 %LOCALAPPDATA%\\StockAnalyzer\\stock.db",
    "DatabasePath": ""
  },
  "DataSource": {
    "TimeoutSeconds": 20,
    "RetryCount": 2,
    "RetryBaseDelayMilliseconds": 400,
    "MaxConcurrentRequests": 4,
    "ListPageSize": 1000,
    "QuoteBatchSize": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
