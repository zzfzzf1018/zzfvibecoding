<Window x:Class="StockAnalyzer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="clr-namespace:StockAnalyzer.Desktop.Charts"
        xmlns:vm="clr-namespace:StockAnalyzer.Desktop.ViewModels"
        Title="A股 / 港股 估值分析终端"
        Height="820" Width="1400"
        MinHeight="620" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============ 顶部工具条 ============ -->
    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="估值分析终端" FontSize="16" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="0,0,20,0" />

        <TextBox Grid.Column="1"
                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                 Tag="输入代码 / 名称 / 拼音首字母，如 600519、茅台、gzmt" />

        <ComboBox Grid.Column="2" Margin="10,0,0,0"
                  ItemsSource="{Binding MarketGroupOptions}"
                  SelectedItem="{Binding SelectedMarketGroup}"
                  DisplayMemberPath="Display" />

        <ProgressBar Grid.Column="3" Height="3" Width="160" IsIndeterminate="True"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource AccentBrush}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <Button Content="同步股票列表" Command="{Binding SyncStockListCommand}" Margin="6,0,0,0" />
          <Button Content="刷新自选行情" Command="{Binding RefreshWatchlistQuotesCommand}" Margin="6,0,0,0" />
          <Button Content="清理缓存" Command="{Binding ClearCacheCommand}" Margin="6,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ 主体 ============ -->
    <Grid Grid.Row="1" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" MinWidth="260" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左侧：搜索结果 / 自选股 -->
      <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8">
        <TabControl>
          <TabItem Header="搜索结果">
            <Grid>
              <TextBlock Style="{StaticResource CaptionText}" Margin="10,20,10,0"
                         TextWrapping="Wrap" VerticalAlignment="Top"
                         Text="在上方输入代码、中文名称或拼音首字母进行模糊检索；双击结果可直接加入自选。"
                         Visibility="{Binding SearchResults.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />

              <ListBox ItemsSource="{Binding SearchResults}"
                       SelectedItem="{Binding SelectedSearchResult}"
                       MouseDoubleClick="OnSearchResultDoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" FontSize="13" />
                        <TextBlock Text="{Binding Code}" Style="{StaticResource CaptionText}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                 Style="{StaticResource CaptionText}"
                                 Text="{Binding Market, Converter={StaticResource MarketNameConverter}}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <TabItem Header="我的自选">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <ListBox Grid.Row="0"
                       ItemsSource="{Binding Watchlist}"
                       SelectedItem="{Binding SelectedWatchlistRow}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" FontSize="13" />
                        <TextBlock Style="{StaticResource CaptionText}">
                          <Run Text="{Binding Code, Mode=OneWay}" />
                          <Run Text=" · PE " /><Run Text="{Binding PeText, Mode=OneWay}" />
                          <Run Text=" · PB " /><Run Text="{Binding PbText, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PriceText}" HorizontalAlignment="Right" FontSize="13"
                                   Foreground="{Binding ChangeValue, Converter={StaticResource ChangeToBrush}}" />
                        <TextBlock Text="{Binding ChangeText}" HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{Binding ChangeValue, Converter={StaticResource ChangeToBrush}}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Button Grid.Row="1" Content="移除选中自选" Margin="0,8,0,0"
                      Command="{Binding RemoveFromWatchlistCommand}"
                      CommandParameter="{Binding SelectedWatchlistRow}" />
            </Grid>
          </TabItem>
        </TabControl>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                    Background="Transparent" ResizeBehavior="PreviousAndNext" />

      <!-- 右侧：个股详情 -->
      <Grid Grid.Column="2" DataContext="{Binding Detail}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding HeaderName}" FontSize="20" FontWeight="Bold" />
              <TextBlock Text="{Binding HeaderCode}" Style="{StaticResource CaptionText}" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
              <TextBlock Text="{Binding HeaderPrice}" FontSize="26" FontWeight="Bold"
                         Foreground="{Binding HeaderTrend, Converter={StaticResource ChangeToBrush}}" />
              <TextBlock Text="{Binding HeaderChange}" FontSize="13"
                         Foreground="{Binding HeaderTrend, Converter={StaticResource ChangeToBrush}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="30,0,0,0">
              <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding QualityNote}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
              <ProgressBar Height="3" IsIndeterminate="True" Margin="0,6,0,0"
                           HorizontalAlignment="Left" Width="180"
                           Background="Transparent" BorderThickness="0"
                           Foreground="{StaticResource AccentBrush}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="加入自选" Style="{StaticResource AccentButton}"
                      Command="{Binding DataContext.AddToWatchlistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding Stock}" />
              <Button Content="强制刷新" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 分析标签页 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10">
          <TabControl>
            <!-- 基本信息 -->
            <TabItem Header="基本信息">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding BasicMetrics}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6"
                              Margin="4" Padding="14,12" ToolTip="{Binding Tooltip}">
                        <StackPanel>
                          <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" />
                          <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                     Foreground="{Binding Trend, Converter={StaticResource ChangeToBrush}}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </TabItem>

            <!-- 历史分位 -->
            <TabItem Header="历史分位">
              <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="市盈率 PE(TTM) 历史分位" Style="{StaticResource SectionTitle}" />
                    <DataGrid ItemsSource="{Binding PePercentiles}" MaxHeight="220">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="窗口" Binding="{Binding Window}" Width="66" />
                        <DataGridTextColumn Header="当前" Binding="{Binding Current}" Width="66" />
                        <DataGridTemplateColumn Header="分位" Width="64">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Percentile}" VerticalAlignment="Center"
                                         Foreground="{Binding PercentileValue, Converter={StaticResource PercentileToBrush}}" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="评价" Binding="{Binding Temperature}" Width="74" />
                        <DataGridTextColumn Header="最小" Binding="{Binding Min}" Width="62" />
                        <DataGridTextColumn Header="30%" Binding="{Binding Q30}" Width="62" />
                        <DataGridTextColumn Header="中位" Binding="{Binding Median}" Width="62" />
                        <DataGridTextColumn Header="70%" Binding="{Binding Q70}" Width="62" />
                        <DataGridTextColumn Header="最大" Binding="{Binding Max}" Width="62" />
                        <DataGridTextColumn Header="样本" Binding="{Binding Samples}" Width="*" MinWidth="96" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock Text="市净率 PB 历史分位" Style="{StaticResource SectionTitle}" />
                    <DataGrid ItemsSource="{Binding PbPercentiles}" MaxHeight="220">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="窗口" Binding="{Binding Window}" Width="66" />
                        <DataGridTextColumn Header="当前" Binding="{Binding Current}" Width="66" />
                        <DataGridTemplateColumn Header="分位" Width="64">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Percentile}" VerticalAlignment="Center"
                                         Foreground="{Binding PercentileValue, Converter={StaticResource PercentileToBrush}}" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="评价" Binding="{Binding Temperature}" Width="74" />
                        <DataGridTextColumn Header="最小" Binding="{Binding Min}" Width="62" />
                        <DataGridTextColumn Header="30%" Binding="{Binding Q30}" Width="62" />
                        <DataGridTextColumn Header="中位" Binding="{Binding Median}" Width="62" />
                        <DataGridTextColumn Header="70%" Binding="{Binding Q70}" Width="62" />
                        <DataGridTextColumn Header="最大" Binding="{Binding Max}" Width="62" />
                        <DataGridTextColumn Header="样本" Binding="{Binding Samples}" Width="*" MinWidth="96" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,8">
                  <TextBlock Text="走势图指标：" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                  <ComboBox ItemsSource="{Binding MetricOptions}" SelectedItem="{Binding SelectedHistoryMetric}"
                            DisplayMemberPath="Display" Margin="6,0,16,0" />
                  <TextBlock Text="窗口：" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                  <ComboBox ItemsSource="{Binding WindowOptions}" SelectedItem="{Binding SelectedHistoryWindow}"
                            DisplayMemberPath="Display" Margin="6,0,0,0" />
                </StackPanel>

                <charts:ValuationHistoryChart Grid.Row="2"
                                              Series="{Binding Series}"
                                              MetricOption="{Binding SelectedHistoryMetric}"
                                              WindowOption="{Binding SelectedHistoryWindow}" />
              </Grid>
            </TabItem>

            <!-- 估值通道 -->
            <TabItem Header="估值通道">
              <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="估值口径：" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                  <ComboBox ItemsSource="{Binding MetricOptions}" SelectedItem="{Binding SelectedChannelMetric}"
                            DisplayMemberPath="Display" Margin="6,0,16,0" />
                  <TextBlock Text="窗口：" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                  <ComboBox ItemsSource="{Binding WindowOptions}" SelectedItem="{Binding SelectedChannelWindow}"
                            DisplayMemberPath="Display" Margin="6,0,0,0" />
                </StackPanel>

                <charts:ValuationChannelChart Grid.Row="1" Channel="{Binding Channel}" />

                <TextBlock Grid.Row="2" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="通道说明：取窗口内 PE/PB 的 10%、30%、50%、70%、90% 分位倍数，乘以逐日的每股收益(TTM)或每股净资产，折算成与股价同坐标的价格带。股价贴近下沿代表估值偏低，贴近上沿代表估值偏高。" />
              </Grid>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
    </Grid>

    <!-- ============ 状态栏 ============ -->
    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="14,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

        <TextBlock Grid.Column="1" Text="{Binding StorageSummary}" Style="{StaticResource CaptionText}"
                   VerticalAlignment="Center" Margin="20,0" />

        <TextBlock Grid.Column="2" Text="{Binding DataSourceName}" Style="{StaticResource CaptionText}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
